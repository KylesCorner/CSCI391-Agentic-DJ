```dotenv
# ==========================================
# ListenBrainz
# ==========================================
LISTENBRAINZ_USER=your_listenbrainz_username
LISTENBRAINZ_TOKEN=your_listenbrainz_api_token

# ==========================================
# MusicBrainz
# ==========================================
# Contact email used for API identification
MB_CONTACT=you@example.com

# ==========================================
# Ollama (Local LLM)
# ==========================================
OLLAMA_HOST=http://localhost:11434

# Default model
OLLAMA_MODEL=qwen3:8b

# Model tiers
ENCORE_CHEAP_MODEL=qwen3:8b
ENCORE_ROUTER_MODEL=qwen3:8b
ENCORE_SUMMARY_MODEL=qwen3:8b
ENCORE_FINAL_MODEL=qwen3-coder:30b

# ==========================================
# Memory / Embeddings
# ==========================================
ENCORE_EMBED_MODEL=nomic-embed-text

ENCORE_DB=./data/encore.sqlite3
ENCORE_EPISODIC_PATH=./data/encore_chroma

# ==========================================
# User / Timezone
# ==========================================
ENCORE_USER_ID=your_listenbrainz_username
ENCORE_TIMEZONE=America/Denver
```
